# Always XX: static site plus a reverse proxy to the gallery API.
# Drop this in /etc/nginx/sites-available/ and symlink it into sites-enabled.

# Keep uploads from queueing up behind the game server.
limit_req_zone $binary_remote_addr zone=alwaysxx_write:1m rate=10r/m;

server {
    listen 80;
    listen [::]:80;
    server_name example.com;

    # certbot --nginx will rewrite this block for TLS.

    root /var/www/always-xx;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript image/svg+xml application/json;
    gzip_min_length 512;

    location / {
        try_files $uri $uri/ =404;
    }

    # Shape artwork never changes once published.
    location ~ ^/api/shapes/[\w-]+/svg$ {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_cache_valid 200 30d;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location /api/ {
        # X-Forwarded-For is what the API rate limits on, so set it here
        # rather than passing through whatever the client sent.
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 30s;
        client_max_body_size 128k;

        limit_req zone=alwaysxx_write burst=5 nodelay;
        limit_req_status 429;
    }
}
